# Canonical origin. Must be https in production; drives metadataBase, canonicals,
# upgrade-insecure-requests and the Reporting API endpoint.
SITE_URL=http://localhost:3000

# Optional media CDN origin (images, video, captions), e.g. https://media.example.com
MEDIA_ORIGIN=

# report-only while tuning the policy; switch to enforce once reports are clean (§11.1).
CSP_MODE=report-only

# Keep false on every non-production deployment so previews never get indexed.
SITE_INDEXABLE=false

# RFC 9116 security contact (mailto: or https URL). When unset, /.well-known/security.txt is 404.
SECURITY_CONTACT=

# ── Enquiry delivery ────────────────────────────────────────────────────────────
# email | log | off. Unset: "email" when SMTP below is filled in, else "log" in development
# and "off" in production (the form then says enquiries are unavailable, never fakes success).
LEADS_MODE=

# SMTP for lead emails. Put real values in .env.local (git-ignored) or your host's secret
# store, never in this file. Google Workspace / Gmail: smtp.gmail.com, port 465, the full
# mailbox address as SMTP_USER and a 16-character App Password (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where leads are sent, and the sender (defaults to SMTP_USER).
LEADS_TO=support@adnikinfra.com
LEADS_FROM=

# ── Marketplace (owner listings, admin review, subscribers) ────────────────────
# supabase | memory | off. Unset: "supabase" when the Supabase keys below are set, else
# "memory" in development (data is lost on restart) and "off" in production.
MARKETPLACE_MODE=

# Supabase project → Settings → API. The service-role key is server-only: never expose it.
# Create the tables by running supabase/migrations/0001_marketplace.sql in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Settings → API Keys. Photos upload straight from the browser, signed by us.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 32+ random characters (e.g. `openssl rand -base64 48`). Signs unsubscribe links.
SIGNING_SECRET=

# Memory mode only: the admin account created at start-up (password 12+ characters).
MARKETPLACE_DEV_ADMIN_EMAIL=admin@example.com
MARKETPLACE_DEV_ADMIN_PASSWORD=
